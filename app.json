{
  "expo": {
    "name": "Hospůdkobraní",
    "slug": "hospudkobrani",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0A00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.fluffini.hospudkobrani",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky.",
        "NSLocationAlwaysUsageDescription": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky.",
        "NSCameraUsageDescription": "Fotit hospůdky!",
        "NSPhotoLibraryUsageDescription": "Přidat fotku z galerie.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0A00"
      },
      "package": "cz.fluffini.hospudkobrani",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "VLOZ_GOOGLE_MAPS_API_KEY_ZDE"
        }
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hospůdkobraní chce přistupovat k tvým fotkám."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e549e18b-82ac-48e2-a4f1-de06e3b76931"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e549e18b-82ac-48e2-a4f1-de06e3b76931"
    }
  }
}
