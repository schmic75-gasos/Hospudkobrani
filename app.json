{
  "expo": {
    "scheme": "hospudkobrani",
    "name": "Hospůdkobraní",
    "slug": "hospudkobrani",
    "version": "1.5.0",
    "author": "Michal Schneider",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F0A00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cz.fluffini.hospudkobrani",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky.",
        "NSLocationAlwaysUsageDescription": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky.",
        "NSCameraUsageDescription": "Fotit hospůdky!",
        "NSPhotoLibraryUsageDescription": "Přidat fotku z galerie.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:hospudkobrani-8888.rostiapp.cz"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0A00"
      },
      "package": "cz.fluffini.hospudkobrani",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "hospudkobrani-8888.rostiapp.cz",
              "pathPrefix": "/pub"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Potřebujeme tvou polohu pro ověření, že jsi u hospůdky."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hospůdkobraní chce přistupovat k tvým fotkám."
        }
      ],
      "expo-font",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.20.1"
        }
      ],
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2764641499857589~3265060801",
          "iosAppId": "ca-app-pub-2764641499857589~3265060801"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e549e18b-82ac-48e2-a4f1-de06e3b76931"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e549e18b-82ac-48e2-a4f1-de06e3b76931"
    }
  }
}
