      "filter": ["in", "class", "wood", "scrub", "grass", "park", "pitch", "golf"],
      "paint": { "fill-color": ["match", ["get", "class"],
          "wood","#1a3a1a", "scrub","#1a2818", "grass","#1e2a1a",
          "park","#1e3a1e", "pitch","#1a2e1a", "golf","#253018", "#1a3a1a"],
        "fill-opacity": 1 } },

    { "id": "landuse-urban", "type": "fill",
